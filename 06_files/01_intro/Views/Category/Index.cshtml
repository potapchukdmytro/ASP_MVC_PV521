@model IEnumerable<Category>

@{
    ViewData["Title"] = "Категорії";
}

<div style="min-height: 100vh;">
    <div class="d-flex">
        <h2 class="text-center flex-1 w-100">Список категорій</h2>
        <div class="me-3">
            <a asp-action="Create" asp-controller="Category">
                <i class="bi bi-plus-circle" style="font-size: 1.6rem;"></i>
            </a>
        </div>
    </div>
    <div class="container">
        <div class="row">
            @foreach (var category in Model)
            {
                <div class="col-3 p-2">
                    <div class="card h-100 p-3 card-hover">
                        <div style="height: 175px;">
                            <img class="w-100 h-100" style="object-fit: contain;" src="~/images/categories/@(category.Image ?? "default.jpg")" alt="@category.Name" />
                        </div>
                        <h3 class="card-header mt-1">@category.Name</h3>
                        <div class="card-body">
                            <p class="card-text">@category.Description</p>
                        </div>
                        <div>
                            <a asp-action="Update" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-success">Редагувати</a>
                            <a asp-action="Delete" asp-controller="Category" asp-route-id="@category.Id" class="btn btn-danger">Видалити</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>