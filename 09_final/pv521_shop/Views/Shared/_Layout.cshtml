@inject IHttpContextAccessor Accessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _01_intro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ПВ521</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Каталог</a>
                        </li>
                        @if(User.IsInRole("admin"))
                        {   
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Category" asp-action="Index">Категорії</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Create">Новий товар</a>
                        </li>
                        <li class="nav-item flex-grow-1">
                            <a class="nav-link" asp-controller="Home" asp-action="About">Про нас</a>
                        </li>
                        <li>
                            <a asp-controller="Cart" asp-action="Index" class="text-black">
                                <div class="position-relative d-flex align-items-center h-100 me-4">
                                    <div class="bg-danger position-absolute rounded-circle align-items-center d-inline-flex justify-content-center" 
                                         style="width: 20px; height: 20px; top: 0; right: -7px;">
                                        <span class="text-white" style="font-size: 0.75rem;">
                                            @* @(Accessor.HttpContext != null 
                                            ? CartService.Count(Accessor.HttpContext.Session) : 0) *@
                                                @if (Accessor.HttpContext != null)
                                                {   
                                                    @CartService.Count(Accessor.HttpContext.Session);
                                                }
                                                else
                                                {
                                                    @:0
                                                }
                                            </span>
                                    </div>
                                    <i class="bi bi-cart3" style="font-size: 1.65rem;"></i>
                                </div>
                            </a>
                        </li>
                        <li>
                            <partial name="_loginPartial"/>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ПВ521 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
