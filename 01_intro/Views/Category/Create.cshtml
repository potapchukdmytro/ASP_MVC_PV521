@model CategoryCreateVM

@{
    ViewData["Title"] = "Нова категорія";
}

<div>
    <h2 class="text-center">Нова категорія</h2>
    <form 
        asp-controller="Category"
        asp-action="Create"
        method="post"
        class="m-auto border p-5 mt-4 rounded-3" 
        style="width: 40%; background-color: #efefef;">
        @* name *@
        <div>
            <label for="name" class="form-label">Назва</label>
            <input asp-for="Name" type="text" class="form-control" id="name" placeholder="Введіть назву категорії">
            <span class="mx-2" style="color: red; font-size: 0.8rem;">Тут буде текст помилки валідації</span>
        </div>

        @* descripton *@
        <div>
            <label for="description" class="form-label mt-4">Опис</label>
            <input asp-for="Description" type="text" class="form-control" id="description" placeholder="Введіть опис категорії">
            <span class="mx-2" style="color: red; font-size: 0.8rem;">Тут буде текст помилки валідації</span>
        </div>

        @* image *@
        <div>
            <label for="image" class="form-label mt-4">Зображення</label>
            <input asp-for="Image" type="text" class="form-control" id="image" placeholder="Введіть посилання на фото">
            <span class="mx-2" style="color: red; font-size: 0.8rem;">Тут буде текст помилки валідації</span>
        </div>

        <div class="mt-4 text-center">
            <input type="submit" class="btn btn-primary w-50" value="Додати"/>
        </div>
    </form>
</div>