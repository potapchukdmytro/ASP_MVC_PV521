@model IEnumerable<Category>

@{
    ViewData["Title"] = "Категорії";
}

<div style="min-height: 100vh;">
    <h2 class="text-center">Список категорій</h2>
    <div class="container">
        <div class="row">
            @foreach(var category in Model)
            {
                <div class="col-3 p-2">
                    <div class="card h-100 p-3 card-hover">
                        <div style="height: 175px;">
                            <img class="w-100 h-100" style="object-fit: contain;" src="@category.Image" alt="@category.Name"/>
                        </div>
                        <h3 class="card-header mt-1">@category.Name</h3>
                        <div class="card-body">
                            <p class="card-text">@category.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>